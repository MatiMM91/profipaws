# Same API as the web frontend (Railway) — recommended for Expo Go on a physical phone.
EXPO_PUBLIC_API_URL=https://profipaws-api-production.up.railway.app

# Optional: local backend instead (Postgres must be running; uvicorn --host 0.0.0.0)
# EXPO_PUBLIC_API_URL=http://192.168.0.145:8000

# Same value as frontend VITE_GOOGLE_CLIENT_ID (required against the production API)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

EXPO_PUBLIC_MAINTENANCE_MODE=false
