# Application
APP_NAME=Profipaws API
# Use production on Railway so dev: Google tokens are rejected.
APP_ENV=development
DEBUG=true

# PostgreSQL (Railway provides DATABASE_URL in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/profipaws

# JWT
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Google OAuth 2.0
# Local only. Leave false or unset in production.
ALLOW_DEV_GOOGLE_LOGIN=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Stripe Subscriptions — Pro: 6.99 EUR/month or 59 EUR/year
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_PRO=price_xxx_monthly_699
STRIPE_PRICE_ID_PRO_YEARLY=price_xxx_yearly_5900

# When true: public locked; only MAINTENANCE_ALLOWLIST emails can sign in
MAINTENANCE_MODE=false
MAINTENANCE_ALLOWLIST=you@gmail.com

# Shared web demo (portfolio / try before signup). Free plan, ~60 min session.
DEMO_LOGIN_ENABLED=true
DEMO_USER_EMAIL=demo@profipaws.com
DEMO_JWT_EXPIRE_MINUTES=60

# Email alerts — Resend (preferred) or SMTP
RESEND_API_KEY=
# Must use a verified domain in Resend (onboarding@resend.dev only sends to your own inbox).
# Example after verifying DNS: Profipaws <avisos@tudominio.com>
RESEND_FROM=Profipaws <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
ALERTS_CRON_SECRET=

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
